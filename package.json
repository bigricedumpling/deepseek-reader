{
  "name": "deepseek-prep-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Typocket: Read, write and organize local documents in DeepSeek Harness.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8090",
    "start:local": "PORT=8090 node server/serve.js",
    "service:install": "node scripts/local-service.mjs install",
    "service:status": "node scripts/local-service.mjs status",
    "service:uninstall": "node scripts/local-service.mjs uninstall",
    "share": "npm run build && node server/serve.js",
    "share:local": "npm run build && node server/serve.js --guest",
    "share:owner": "npm run build && node server/serve.js",
    "check": "node scripts/check-imports.mjs",
    "test:readonly": "node scripts/test-readonly.mjs",
    "test:fold": "node scripts/test-editor-fold.mjs",
    "test:block": "node scripts/test-block-conversion.mjs",
    "regression": "node scripts/regression.mjs",
    "e2e": "node scripts/e2e/roundtrip.mjs && node scripts/e2e/controls.mjs && node scripts/e2e/colwidth.mjs && node scripts/e2e/sidebar.mjs",
    "test:access": "node scripts/test-access.mjs",
    "test:routes": "node scripts/test-routes.mjs",
    "test:plugin": "node scripts/test-plugin.mjs && node scripts/test-plugin-bundle.mjs && node scripts/test-plugin-live.mjs",
    "test:transfer": "node scripts/test-transfer-preview.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "test:lifecycle": "node scripts/test-managed-server.mjs",
    "test:user-recovery": "node scripts/test-user-recovery.mjs",
    "test:upgrade": "node scripts/test-upgrade.mjs",
    "test:workflow": "node scripts/test-workflow.mjs",
    "measure:performance": "node scripts/measure-performance.mjs",
    "brand:sync": "node scripts/sync-brand.mjs",
    "brand:check": "node scripts/sync-brand.mjs --check",
    "predev": "npm run brand:sync",
    "prebuild": "npm run brand:sync"
  },
  "dependencies": {
    "@codemirror/language-data": "^6.5.2",
    "@fontpkg/chill-kai": "^2.0.1",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@phosphor-icons/vue": "^2.2.1",
    "dompurify": "3.4.16",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.0.0",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "shiki": "^4.4.3",
    "tex-linebreak": "^0.9.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.7"
  },
  "overrides": {
    "dompurify": "3.4.16",
    "lodash-es": "4.18.1"
  }
}
