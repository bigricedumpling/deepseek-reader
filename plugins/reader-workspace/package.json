{
  "name": "dsh-reader-workspace",
  "version": "0.2.0-preview.5",
  "description": "Typocket: Read, write and organize local documents in DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigricedumpling/deepseek-reader.git",
    "directory": "plugins/reader-workspace"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "markdown",
    "knowledge-base",
    "reader"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "brand.js",
    "client.js",
    "managed-server.js",
    "platform.js",
    "cordis.patch.yml",
    "scripts/reader.mjs",
    "locale/*.json",
    "runtime/dist/**",
    "runtime/server/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../../scripts/prepare-plugin.mjs"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web"
    }
  }
}
